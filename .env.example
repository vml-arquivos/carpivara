# Runtime
NODE_ENV=development
PORT=4000
APP_NAME=Carpivara
APP_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:5173
TRUST_PROXY=1

# Database
DATABASE_URL=postgresql://vehicle:vehicle_dev_password@localhost:5432/vehicle_sandbox
DATABASE_SSL=false

# Security — nunca reutilize este valor em produção; gere ao menos 64 caracteres aleatórios.
JWT_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET_OF_AT_LEAST_64_CHARACTERS
JWT_EXPIRES_IN=2h

# Vehicle provider — mock funciona sem credenciais externas.
DATA_PROVIDER=mock
VEHICLE_API_BASE_URL=
VEHICLE_API_LOGIN=
VEHICLE_API_PASSWORD=
VEHICLE_API_TOKEN=
VEHICLE_API_TIMEOUT_MS=15000
QUERY_CACHE_ENABLED=true
QUERY_CACHE_TTL_SECONDS=3600
QUERY_REQUEST_TIMEOUT_MS=20000

# Payments — mantenha sandbox até que um gateway e webhook verificado sejam implementados.
PAYMENT_PROVIDER=sandbox
PAYMENT_API_BASE_URL=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# Rate limiting, logging and audit
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
LOGIN_RATE_LIMIT_MAX=10
LOG_LEVEL=info
LOG_SENSITIVE_DATA=false
AUDIT_LOG_ENABLED=true
STORE_RAW_PROVIDER_RESPONSE=true

# Sandbox — habilite apenas em desenvolvimento, homologação ou demonstração.
SANDBOX_SEED_ENABLED=true
SANDBOX_CREDIT_PURCHASE_ENABLED=true
