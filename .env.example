# Runtime
NODE_ENV=development
PORT=4000
APP_NAME=Carpivara
APP_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:5173
TRUST_PROXY=1

# Database
DATABASE_URL=postgresql://vehicle:vehicle_dev_password@localhost:5432/vehicle_sandbox
DATABASE_SSL=false

# Security - use at least 64 random characters in production
JWT_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET_OF_AT_LEAST_64_CHARACTERS
JWT_EXPIRES_IN=2h

# Vehicle provider
DATA_PROVIDER=mock
VEHICLE_API_BASE_URL=
VEHICLE_API_LOGIN=
VEHICLE_API_PASSWORD=
VEHICLE_API_TOKEN=
VEHICLE_API_TIMEOUT_MS=15000

# Payments - keep sandbox until a real gateway is integrated
PAYMENT_PROVIDER=sandbox
PAYMENT_WEBHOOK_SECRET=

# Feature controls
SANDBOX_SEED_ENABLED=true
SANDBOX_CREDIT_PURCHASE_ENABLED=true
