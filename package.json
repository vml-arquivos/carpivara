{
  "name": "buscarr-platform",
  "private": true,
  "version": "0.3.2",
  "workspaces": ["apps/api", "apps/web"],
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w apps/api && npm run build -w apps/web",
    "test": "npm run build && node --test apps/api/test/**/*.test.mjs",
    "start": "npm run start -w apps/api"
  },
  "devDependencies": {"npm-run-all": "^4.1.5"}
}
